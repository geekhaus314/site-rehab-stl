{
  "title": "Site Boilerplate Business Profile",
  "type": "object",
  "required": ["id", "name", "domain", "theme", "content", "contact"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique machine-safe identifier for this client installation",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "description": "Human-readable business name",
      "minLength": 1,
      "maxLength": 120
    },
    "domain": {
      "type": "string",
      "description": "Canonical production domain (no protocol)",
      "pattern": "^[a-z0-9]+([\\-\\.]{1}[a-z0-9]+)*\\.[a-z]{2,}$",
      "minLength": 1
    },
    "theme": {
      "type": "object",
      "required": ["primary", "background", "surface", "text", "muted", "accent"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Primary brand color (hex)"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Main page background color (hex)"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Card/surface container color (hex)"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Primary text color (hex)"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Secondary/muted text color (hex)"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Accent/highlight color (hex)"
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["tagline", "description", "hero", "services", "about", "footer"],
      "additionalProperties": false,
      "properties": {
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "hero": {
          "type": "object",
          "required": ["headline", "subheadline", "ctaLabel"],
          "properties": {
            "headline": { "type": "string", "minLength": 1 },
            "subheadline": { "type": "string", "minLength": 1 },
            "ctaLabel": { "type": "string", "minLength": 1 }
          }
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "about": {
          "type": "object",
          "required": ["headline", "body"],
          "properties": {
            "headline": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 }
          }
        },
        "footer": {
          "type": "object",
          "required": ["copyrightEntity"],
          "properties": {
            "copyrightEntity": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["email", "phone", "address"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 }
      }
    }
  }
}
